# Secrets — never commit. Env vars only.
.env
.env.*
!.env.example

# The estate lives in projects/ as separate git repos — never tracked here.
# This blanket exclusion is the whole mechanism: it is what keeps client code,
# client data and 22 unrelated histories out of this repo. It has no exceptions
# and never gains one — a repo that needs tracking gets its own remote, not a
# negation line here.
/projects/

# OS / editor
.DS_Store
*.log
.idea/

# Claude Code accretion layer stays per-machine (settings.json is clean policy).
.claude/settings.local.json

# Deal folders: rendered documents are build artefacts, and client media is never committed.
# Transcripts (.txt, .md) under raw/ stay tracked — the words matter, the bytes do not.
workspaces/deals/**/out/
workspaces/deals/**/raw/*.mp4
workspaces/deals/**/raw/*.mov
workspaces/deals/**/raw/*.m4a
workspaces/deals/**/raw/*.mp3
workspaces/deals/**/raw/*.wav
workspaces/deals/**/raw/*.webm
workspaces/deals/**/raw/*.mkv
workspaces/deals/**/raw/*.aac
workspaces/deals/**/raw/*.ogg
workspaces/deals/**/raw/*.opus
workspaces/deals/**/raw/*.amr
workspaces/deals/**/raw/*.flac
workspaces/deals/**/raw/*.avi

# Until this repo is private again (Jamie: end of September 2026) the deal folders' private/
# reasoning stays out of git — D24 wants it here, and it returns the day the flip lands
# (.icm/intake/triage/retrack-deal-private-after-flip.md). The files stay on disk.
workspaces/deals/**/private/
